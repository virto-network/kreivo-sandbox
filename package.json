{
  "name": "@virto-network/kreivo-sandbox",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "bun@1.2.15",
  "bin": {
    "kreivo-sandbox": "dist/bin/kreivo-sandbox.mjs",
    "kreivo-sandbox-utils": "dist/bin/kreivo-sandbox-utils.mjs"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./endpoints": {
      "import": "./dist/lib/config/endpoints.js",
      "types": "./dist/lib/config/endpoints.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "cli": "bun run bin/kreivo-sandbox.mts",
    "utils": "bun run bin/kreivo-sandbox-utils.mts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@acala-network/chopsticks-executor": "^1.4.1",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polkadot-api/forklift": "^0.4.1",
    "@polkadot-api/metadata-builders": "^0.14.3",
    "@polkadot-api/signer": "^0.3.3",
    "@polkadot-api/substrate-bindings": "^0.20.3",
    "@polkadot-labs/hdkd-helpers": "^0.0.31",
    "commander": "^15.0.0",
    "console-table-printer": "^2.16.1",
    "express": "^5.1.0",
    "polkadot-api": "^2.2.1",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "ws": "^8.21.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/express": "^5.0.5"
  }
}
